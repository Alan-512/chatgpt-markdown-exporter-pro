{
  "manifest_version": 3,
  "name": "ChatGPT Markdown Exporter Pro",
  "version": "1.0",
  "description": "Instantly export complete ChatGPT conversations to Markdown or JSON without scrolling. Handles ultra-long chats, LaTeX, and code interpreter outputs.",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ]
}
